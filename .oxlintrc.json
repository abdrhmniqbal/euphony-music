{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["import", "react", "typescript", "unicorn"],
  "ignorePatterns": ["android/app/build", "src_dep", "src/components/icons"],
  "settings": {
    "react": {
      "version": "19.0"
    }
  },
  "rules": {
    "import/no-cycle": "error"
  }
}
